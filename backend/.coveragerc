[run]
branch = True
source =
    apps
omit =
    */migrations/*
    */__init__.py
    */tests/*
    */apps.py
    */admin.py
    */wsgi.py
    */asgi.py
    */manage.py
    */tests.py
    */test_*.py
    */__pycache__/*
    */management/commands/*


[report]
fail_under = 80
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = coverage_html
